# Kopieren nach secrets.yaml und ausfuellen. secrets.yaml NIE ins Repository.
wifi_ssid: "MeinWLAN"
wifi_password: "wlan-passwort"
ap_password: "notfall-hotspot-passwort"   # Hotspot, falls das WLAN nicht erreichbar ist
ota_password: "ota-passwort"
web_password: "passwort-fuer-die-weboberflaeche"   # Benutzer: admin

# MQTT-Broker (Messwerte, Lese- und Scan-Befehle)
mqtt_broker: "192.0.2.10"
mqtt_user: "esp-heizung"
mqtt_password: "mqtt-passwort"

# Weishaupt WEM (Systemgeraet mit Netzwerkanschluss)
wem_ip: "192.0.2.20"      # im Web aenderbar
wem_user: "admin"         # Werkseinstellung Weishaupt, laut Anleitung nicht aenderbar
wem_pass: "Admin123"      # Werkseinstellung Weishaupt, laut Anleitung nicht aenderbar
