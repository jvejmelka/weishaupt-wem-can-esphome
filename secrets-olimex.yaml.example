# Fuer olimex-weishaupt.yaml: kopieren nach secrets.yaml und ausfuellen. secrets.yaml NIE ins Repository.
# (Ethernet: kein WLAN noetig. Wer schon eine secrets.yaml nach secrets.yaml.example hat, braucht nichts weiter.)
ota_password: "ota-passwort"
web_password: "passwort-fuer-die-weboberflaeche"   # Benutzer: admin

# WEM (Systemgeraet mit Netzwerkanschluss): IP und Werkszugang laut Weishaupt-Anleitung.
# Nur noetig, wenn per JSON statt per CAN geschaltet wird (Schalter "Schalten per CAN statt JSON" aus).
wem_ip: "192.0.2.20"
wem_user: "admin"
wem_pass: "Admin123"
